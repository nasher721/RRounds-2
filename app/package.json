{
  "name": "rolling-rounds",
  "private": true,
  "version": "1.0.0",
  "description": "Offline-aware clinical rounding workspace for patient lists, notes, tasks, and team handoffs.",
  "main": "electron/main.cjs",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0 <11.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-size.mjs",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --incremental false && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:8080 && electron .\"",
    "desktop:preview": "npm run build:dev && ELECTRON_SERVE_DIST=1 electron .",
    "desktop:dist": "npm run build && electron-builder",
    "test": "node --import ./scripts/test-setup.mjs --loader ./scripts/test-mock-loader.mjs --loader ./scripts/supabase-mock-loader.mjs --loader ./scripts/ts-loader.mjs --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "test:auth": "node --import ./scripts/test-setup.mjs --loader ./scripts/supabase-mock-loader.mjs --loader ./scripts/ts-loader.mjs --test src/hooks/__tests__/useAuth.test.tsx src/pages/__tests__/Auth.test.tsx",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:preview": "node scripts/test-e2e-preview.mjs",
    "test:e2e:public": "playwright test --grep \"@public\"",
    "test:e2e:synthetic": "playwright test --project=synthetic-chromium",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:ui": "playwright test --project=chromium --ui",
    "edge:check-jwt-config": "node scripts/assert-edge-verify-jwt-config.mjs",
    "edge:bundle-mcp": "node scripts/build-mcp-edge-bundle.mjs",
    "edge:verify": "deno fmt --check supabase/functions && deno lint supabase/functions && deno check --no-config --lock deno.lock --frozen supabase/functions/_shared/*.ts supabase/functions/*/index.ts && deno test --no-config --lock deno.lock --frozen supabase/functions",
    "verify:migrations": "node scripts/verify-supabase-migration-order.mjs",
    "security:check-auth-config": "node scripts/assert-auth-security-config.mjs",
    "security:check-client-bundle": "node scripts/assert-client-secret-not-bundled.mjs",
    "security:check-bundle-reachability": "node scripts/assert-no-optional-native-in-bundle.mjs",
    "clinical:typecheck": "npm --prefix clinical-mcp-server run typecheck",
    "clinical:test": "npm --prefix clinical-mcp-server test",
    "clinical:build": "npm --prefix clinical-mcp-server run build",
    "audit:prod": "npm audit --omit=dev --omit=optional",
    "verify:local": "npm run lint && npm run typecheck && npm test && npm run security:check-auth-config && npm run edge:check-jwt-config && npm run verify:migrations && npm run audit:prod && npm run edge:verify && npm run clinical:typecheck && npm run clinical:test && npm run clinical:build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-context-menu": "^2.2.15",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-hover-card": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.13",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@sentry/react": "^8.55.0",
    "@supabase/supabase-js": "^2.89.0",
    "@swc/core": "^1.15.21",
    "@syncedstore/core": "^0.6.0",
    "@syncedstore/react": "^0.6.0",
    "@tanstack/react-query": "^5.83.0",
    "@types/react-window": "^1.8.8",
    "@unovis/react": "^1.6.4",
    "@unovis/ts": "^1.6.4",
    "animejs": "^4.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^4.3.0",
    "dompurify": "^3.4.12",
    "embla-carousel-react": "^8.6.0",
    "fhirclient": "^2.6.3",
    "framer-motion": "^12.34.1",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.462.0",
    "mammoth": "^1.11.0",
    "openai": "^6.32.0",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.61.1",
    "react-resizable-panels": "^2.1.9",
    "react-router-dom": "7.18.2",
    "react-window": "^2.2.5",
    "recharts": "^2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.29",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.16.5",
    "@types/react": "~18.3.23",
    "@types/react-dom": "~18.3.7",
    "@vitejs/plugin-react-swc": "4.3.3",
    "agentation": "^3.0.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.28.2",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "8.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "concurrently": "^9.1.0",
    "wait-on": "^8.0.1"
  },
  "overrides": {
    "expo-random": "11.0.0",
    "@unimodules/core": "7.2.0",
    "@unimodules/react-native-adapter": "6.5.0",
    "react-native-securerandom": "0.1.1",
    "react-native": "0.87.0",
    "@babel/core": "7.29.7",
    "base64-js": "1.5.1"
  },
  "build": {
    "appId": "com.rollingrounds.app",
    "productName": "Rolling Rounds",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "public/icons/**/*", "package.json"],
    "mac": { "category": "public.app-category.medical", "target": ["dmg"] },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage"] }
  }
}
